# Hopsworks Feature Store & Model Registry Configuration
# Copy this file to .env and replace with your actual keys
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT=MA
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PORT=443

# Real SMTP Email Alert Dispatcher Configuration (Gmail / Custom SMTP)
# (DO NOT COMMIT YOUR REAL PASSWORD OR API KEYS TO GITHUB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER_NAME=Pearls AQI Intelligence

